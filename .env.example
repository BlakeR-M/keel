# Keel configuration. Copy to .env and edit. Every value has a safe default for the on-prem demo.

# Deployment profile: local | azure
KEEL_PROFILE=local

# Data directory (SQLite store, ledger, logs)
KEEL_DATA_DIR=./data

# Air-gap mode: when 1, any outbound network call other than 127.0.0.1 is refused.
KEEL_AIRGAP=0

# --- local profile ---
KEEL_LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
KEEL_LOCAL_LLM_MODEL=qwen2.5-3b-instruct
KEEL_LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
KEEL_LOCAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Seconds per model call; raise it for a slow CPU-only server (the hosted demo uses 300).
KEEL_LOCAL_LLM_TIMEOUT=120

# --- azure profile (no keys: DefaultAzureCredential / managed identity) ---
KEEL_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
KEEL_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
KEEL_AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
KEEL_AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
KEEL_AZURE_SEARCH_INDEX=keel-chunks

# --- web ---
KEEL_HOST=127.0.0.1
KEEL_PORT=8400
# Beyond loopback: admin routes need X-Keel-Admin-Token equal to this; identity comes from a proxy
# that proves itself with X-Keel-Proxy-Token equal to KEEL_PROXY_TOKEN. Both unset by default.
# KEEL_ADMIN_TOKEN=
# KEEL_PROXY_TOKEN=

# --- hosted demo of the fixture corpus (deploy/railway/README.md). Never set for a real deployment ---
# KEEL_DEMO_IDENTITY=1        honour the chat page's demo user picker beyond loopback
# KEEL_DEMO_READONLY=1        declare the read-only posture (no web ingest; writes are admin-only)
# KEEL_BOOTSTRAP_CORPUS=fixtures/corpus.yaml   ingest this manifest at startup when the store is empty

# --- optional second-opinion judge for evals ---
GEMINI_API_KEY=
